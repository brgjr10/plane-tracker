# Copy to `.env` and adjust values. Docker Compose reads `.env` automatically.

# OpenSky Network (optional). Without credentials the feed falls back to public
# ADS-B sources below. Create an account/app at https://opensky-network.org/.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ADS-B fallback sources (readsb-style JSON). Defaults work for global coverage.
ADSB_LOL_URL=https://api.adsb.lol/v2/lat/0/lon/0/dist/25000
ADSB_FI_URL=https://opendata.adsb.fi/api/v2/lat/0/lon/0/dist/25000

# airplanes.live (opt-in). Leave empty unless you have coordinated access/a URL.
AIRPLANES_LIVE_URL=
